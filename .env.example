# Supabase 프로젝트 대시보드 > Project Settings > API 에서 복사.
# 실제 값은 .env 파일을 새로 만들어서 넣어주세요 (.env는 git에 안 올라갑니다).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 티칭 탭 (유튜브 인기 영상) — Google Cloud Console에서 발급.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# 티칭 탭 (네이버 검색) — developers.naver.com에서 발급.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# 팁방 탭 (수영장 지도) — developers.kakao.com에서 발급.
EXPO_PUBLIC_KAKAO_MAP_APP_KEY=
