# Supabase 프로젝트 대시보드 > Project Settings > API 에서 복사.
# 실제 값은 .env 파일을 새로 만들어서 넣어주세요 (.env는 git에 안 올라갑니다).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 티칭 탭 (유튜브 인기 영상) — Google Cloud Console에서 발급.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# 티칭 탭 (네이버 검색) — developers.naver.com에서 발급.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# 팁방 탭 (길찾기 외부 링크용, 선택) — developers.kakao.com에서 발급.
EXPO_PUBLIC_KAKAO_MAP_APP_KEY=

# 팁방 탭 (수영장 지도, 네이버지도 JS) — console.ncloud.com/maps/application에서 발급.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 팁방 탭 (전국 수영장 데이터) — data.go.kr "행정안전부_생활_수영장업 조회서비스"에서 발급.
EXPO_PUBLIC_POOL_DATA_API_KEY=

# 사용 통계·오류 수집 (PostHog) — posthog.com 프로젝트 설정의 Project API Key (phc_로 시작, 앱에 들어가는 공개 키).
# 지역에 맞게 호스트를 고른다: 미국 https://us.i.posthog.com , 유럽 https://eu.i.posthog.com
# 비워두면 통계를 보내지 않는다.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
